rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['maykon.euro@gmail.com', 'administrador@exemplo.com'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin']
      );
    }

    function isOwner(data) {
      return isSignedIn() && (
        data.ownerId == request.auth.uid || 
        data.professionalId == request.auth.uid ||
        data.userId == request.auth.uid
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidStudent(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.ra is string && data.ra.size() <= 50 &&
             data.ownerId == request.auth.uid;
    }

    function isValidSchool(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.cnpj is string && data.cnpj.size() <= 20 &&
             data.email is string && data.email.size() <= 100 &&
             data.ownerId == request.auth.uid;
    }

    function isValidAppointment(data) {
      return data.studentId is string && data.studentId.size() <= 100 &&
             data.date is string &&
             data.ownerId == request.auth.uid;
    }

    // 4. Match Blocks

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().role != 'admin';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phoneNumber', 'photoUrl'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
        incoming().keys().hasAll(['name', 'ra', 'schoolId', 'ownerId', 'createdAt']) &&
        isValidStudent(incoming()) && isValidId(studentId);
        
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin()) && 
        isValidStudent(incoming()) && 
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt;
        
      allow delete: if isAdmin();
    }

    match /schools/{schoolId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
        incoming().keys().hasAll(['name', 'cnpj', 'email', 'ownerId', 'createdAt']) &&
        isValidSchool(incoming()) && isValidId(schoolId);
        
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin()) && 
        isValidSchool(incoming()) && 
        incoming().ownerId == existing().ownerId;
        
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
        isValidAppointment(incoming()) && 
        incoming().createdAt == request.time &&
        isValidId(appointmentId);
        
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin()) && 
        isValidAppointment(incoming()) && 
        incoming().ownerId == existing().ownerId;
        
      allow delete: if isAdmin();
    }

    match /documents/{docId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
        incoming().ownerId == request.auth.uid && 
        isValidId(docId);
        
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin()) && 
        incoming().ownerId == existing().ownerId;
        
      allow delete: if isAdmin();
    }

    match /scheduling_requests/{requestId} {
      allow get: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if true; // Public requests
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin()) &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']));
        
      allow delete: if isAdmin();
    }

    match /anonymous_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /letterheads/{letterheadId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || isAdmin() || resource.data.isDefault == true);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin()) && incoming().ownerId == existing().ownerId;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin());
      allow delete: if isAdmin();
    }

    match /appointment_types/{typeId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin());
      allow delete: if isAdmin();
    }

    match /document_layouts/{layoutId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(existing()) || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /leads/{leadId} {
      allow create: if true;
      allow read: if isAdmin();
    }
  }
}
